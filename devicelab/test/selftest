# ensure_device against a scripted listing, with each serial's kind stated: emulator-5554 is a phone,
# emulator-5556 a television, and a boot lists emulator-5558 as whatever kind was asked for. Waiting
# and killing are recorded rather than done.
chooses() { # kind listing
    local kind="$1"
    rm -rf "$scratch/choose" && mkdir -p "$scratch/choose"
    printf 'List of devices attached\n%b' "$2" > "$scratch/choose/listing"
    (
        DEVICELAB_DEVICE="$kind" SERIAL=""
        adb_devices() {
            cat "$scratch/choose/listing"
            [ ! -f "$scratch/choose/booted" ] || printf 'emulator-5558\tdevice\n'
        }
        device_answers() { :; }
        device_kind() {
            if [ -n "${SILENT:-}" ] && [ "$1" = "$SILENT" ]; then return 0; fi
            case "$1" in
                emulator-5554) echo phone ;;
                emulator-5556 | emulator-5557) echo tv ;;
                emulator-5558) echo "$DEVICELAB_DEVICE" ;;
            esac
        }
        wait_for_boot() { echo "wait_for_boot $1" >> "$scratch/choose/calls"; }
        boot_avd() {
            echo "boot_avd $(device_property avd)" >> "$scratch/choose/calls"
            touch "$scratch/choose/booted"
            SERIAL=emulator-5558
        }
        ensure_device && echo "chose: $SERIAL"
    ) 2>&1
    cat "$scratch/choose/calls" 2>/dev/null || true
}

