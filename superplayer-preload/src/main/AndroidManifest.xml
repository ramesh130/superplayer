<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      The install-time permission core already declares, declared again because this module's own code
      reads the network: PlatformRules.kt's data-saver rule watches whether the default network is
      metered (ADR-0010 rule 11). Lint checks a module against its own manifest and not against the ones
      it merges with, so core's declaration does not satisfy it here. A consumer gains nothing it did
      not already have: core and Media3's exoplayer artifact both declare the same permission.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

</manifest>
