+/**
+ * A row's name as its stand-in's title, at the largest size at which it still fits the row on one line,
+ * so that a row with no picture yet still fills its space with something to read. The size moves in fine
+ * steps so that the title does not visibly jump as the row's width changes.
+ */
+@Composable
+private fun RowTitle(text: String) {
+    val measurer = rememberTextMeasurer()
+    BoxWithConstraints(contentAlignment = Alignment.Center) {
+        val fits = Constraints(maxWidth = constraints.maxWidth)
+        var size = ROW_TITLE_MIN_SP
+        while (size < ROW_TITLE_MAX_SP &&
+            !measurer.measure(text, TextStyle(fontSize = (size + ROW_TITLE_STEP_SP).sp), maxLines = 1, softWrap = false, constraints = fits)
+                .hasVisualOverflow
+        ) {
+            size += ROW_TITLE_STEP_SP
+        }
+        Text(text = text, fontSize = size.sp, maxLines = 1)
+    }
+}
