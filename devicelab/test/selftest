# The feed's verdict, over the fixture's two passes (19:40:05–15 and 15–25) and a recording that started
# at 19:39:59.000+11:00: a sample every half second, from the demo's pid and, once, from another.
feed_series() { # pass-two offset in MiB
    awk -v extra="$1" 'BEGIN {
        for (t = 0; t <= 30000; t += 500) {
            mib = 100 + (t / 500) % 5
            if (t > 16000) mib += extra
            printf "%d\t753\t%d\n", t, mib * 1048576
        }
        printf "8000\t812\t%d\n", 900 * 1048576
    }'
}
