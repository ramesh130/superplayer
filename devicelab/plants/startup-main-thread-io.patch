+package com.superplayer.demo
+
+import android.app.Application
+import android.util.Log
+import java.io.File
+import java.util.zip.CRC32
+
+/**
+ * The demo's process-wide start. It checks the catalog cache on disk before any screen reads it, so a
+ * cache that a crash left half-written is found, and rebuilt, at launch rather than halfway through a
+ * scroll.
+ */
+class DemoApplication : Application() {
+
+    override fun onCreate() {
+        super.onCreate()
+        val cache = File(filesDir, CATALOG_CACHE)
+        if (!cache.isFile || cache.length() != CATALOG_CACHE_BYTES) {
+            rebuild(cache)
+        }
+        Log.i(TAG, "catalog cache checked, crc32 %08x".format(checksum(cache)))
+    }
+
+    private fun rebuild(cache: File) {
+        val block = ByteArray(BLOCK_BYTES) { it.toByte() }
+        cache.outputStream().use { output ->
+            repeat((CATALOG_CACHE_BYTES / BLOCK_BYTES).toInt()) { output.write(block) }
+        }
+    }
+
+    private fun checksum(cache: File): Long {
+        val crc = CRC32()
+        val buffer = ByteArray(BLOCK_BYTES)
+        cache.inputStream().use { input ->
+            while (true) {
+                val read = input.read(buffer)
+                if (read < 0) break
+                crc.update(buffer, 0, read)
+            }
+        }
+        return crc.value
+    }
+
+    private companion object {
+        const val TAG = "DemoApplication"
+        const val CATALOG_CACHE = "catalog.cache"
+        const val CATALOG_CACHE_BYTES = 192L * 1024 * 1024
+        const val BLOCK_BYTES = 64 * 1024
+    }
+}
