<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      The same install-time permission core's manifest declares. TransportReplay reads the active
      network from Robolectric's connectivity shadow to replay a trace's handover into it, and lint
      checks this module's call against this module's own manifest. A test-support module is never
      in a shipped app, so nothing a consumer installs gains anything here.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Install-time as well. DownloadConditions states a low battery and low storage the way a device
      announces them, as sticky broadcasts, and lint checks that call against this manifest for the same
      reason. Test support only, never in a shipped app.
    -->
    <uses-permission android:name="android.permission.BROADCAST_STICKY" />

</manifest>
