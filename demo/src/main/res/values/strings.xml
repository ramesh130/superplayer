<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">SuperPlayer Demo</string>
    <string name="stream_hls">HLS</string>
    <string name="stream_dash">DASH</string>

    <!-- What the notification, the lock screen and a car head unit call the content. Separate from
         the picker labels above: a viewer looking at a notification has never seen the picker. -->
    <string name="stream_hls_title">BipBop Advanced</string>
    <string name="stream_hls_subtitle">Apple HLS reference stream</string>
    <string name="stream_dash_title">Tears of Steel</string>
    <string name="stream_dash_subtitle">DASH clear H.264</string>

    <!-- The playback profiles, in the vocabulary a viewer of the demo would use. The library's own
         names are longer and say what the case is; these are picker labels. -->
    <string name="profile_video_on_demand">On demand</string>
    <string name="profile_live_linear">Live</string>
    <string name="profile_short_form">Short-form</string>
    <string name="profile_tv_leanback">TV</string>
    <string name="profile_data_saver">Data saver</string>

    <!-- The status line under the picker. It reports what the *player* was asked to do, so that
         resume is visible as an intent and not only as a frame that happens to look familiar. -->
    <string name="status_from_start">%1$s \u2014 playing from the start</string>
    <string name="status_resuming">%1$s \u2014 resuming from %2$s</string>

    <!-- The second status line: what the chosen profile actually decided, read off the player. The
         numbers are here so that switching profiles is observable as policy and not only as a
         picture that looks a bit softer. -->
    <string name="policy_summary">%1$s \u2014 buffers %2$d\u2013%3$ds, %4$s</string>
    <string name="policy_quality_uncapped">quality uncapped</string>
    <string name="policy_quality_height">max %1$dp</string>
    <string name="policy_quality_bitrate">max %1$d kbps</string>
    <string name="policy_quality_height_and_bitrate">max %1$dp at %2$d kbps</string>

    <!-- The feed screen. The summary and the per-row first frame are the whole point of that screen:
         they make "players are bounded, decoders are held warm, the cache is being read" something a
         viewer can watch rather than a claim. -->
    <string name="screen_player">Player</string>
    <string name="screen_feed">Feed</string>
    <string name="feed_summary">Pool: %1$d in use, %2$d built, max %3$d \u00b7 %4$d warm \u00b7 %5$d cache hits</string>
    <string name="feed_row_placeholder">%1$s \u2014 no player free</string>
    <string name="feed_row_first_frame">first frame %1$d ms</string>
    <string name="feed_row_first_frame_from_adoption">first frame %1$d ms (from adoption, not intent)</string>
    <!-- The downloads screen. Each row says what holds its download, because "stopped" alone does not tell a
         viewer whether to find Wi-Fi, a charger or some space. -->
    <string name="screen_downloads">Downloads</string>
    <string name="screen_hud">HUD</string>
    <!-- Shown in place of the overlay where the build is not debuggable, so a missing HUD reads as a
         guard rather than as a defect. -->
    <string name="hud_release_build">The debug HUD shows nothing: this build is not debuggable.</string>
    <string name="hud_action_play_pause">Play / pause</string>
    <string name="downloads_channel_name">Downloads</string>
    <string name="downloads_row_state">%1$s \u00b7 %2$d MB</string>
    <string name="downloads_state_none">Not downloaded</string>
    <string name="downloads_state_queued">Queued</string>
    <string name="downloads_state_downloading">Downloading</string>
    <string name="downloads_state_stopped">Stopped</string>
    <string name="downloads_state_completed">Downloaded</string>
    <string name="downloads_state_failed">Failed</string>
    <string name="downloads_state_removing">Removing</string>
    <string name="downloads_held_no_unmetered_network">Waiting for Wi-Fi or another unmetered network</string>
    <string name="downloads_held_no_network">Waiting for a network</string>
    <string name="downloads_held_data_saver">Held by Data Saver</string>
    <string name="downloads_held_battery_low">Waiting for the battery to recover</string>
    <string name="downloads_held_storage_low">Waiting for storage to be freed</string>
    <string name="downloads_held_network_lost">Network lost \u2014 resuming on its own</string>
    <string name="downloads_refused_live">Live content cannot be downloaded</string>
    <string name="downloads_failed_with">Failed: %1$s</string>
    <string name="downloads_licence_valid">Licence valid</string>
    <string name="downloads_licence_renewal_due">Licence renewal due</string>
    <string name="downloads_licence_expired">Licence expired</string>
    <string name="downloads_action_download">Download</string>
    <string name="downloads_action_play">Play</string>
    <string name="downloads_action_remove">Remove</string>
    <string name="screen_moq">MoQ</string>
    <string name="moq_live_note">Live over QUIC. There is no timeline to seek and no end to reach: leaving this screen releases the player, which is what closes the session.</string>
</resources>
