<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Background playback. The first two let the playback service run in the foreground with the
         `mediaPlayback` type; the third lets its notification actually appear, and from API 33 it is
         a runtime permission the app has to ask for as well (see MainActivity).

         These are the app's rather than the library's on purpose. `FOREGROUND_SERVICE_MEDIA_PLAYBACK`
         is a service type an app has to justify to Google Play, and a library that merged it into
         every consumer's manifest would be making that commitment for apps that never start a
         service. See PlaybackService's documentation. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:theme="@style/Theme.SuperPlayerDemo">
        <!-- Lets shell-side tools profile this app when it is not debuggable: Perfetto's java_hprof
             and heapprofd, and Macrobenchmark, can only attach to an app that is debuggable or
             profileable. A debug build is debuggable already, so this changes nothing there; what it
             does is make the `benchmark` build type measurable, and that is the build devicelab
             measures on (see devicelab/README.md).

             The app's rather than the library's, for the same reason as the permissions above.
             Whether shell tools may profile an app is a decision the app makes about itself, and a
             library that declared it would merge that decision into every consumer's release build.
             No superplayer-* module declares it. Ignored below API 29, which minSdk 24 tolerates. -->
        <profileable
            android:shell="true"
            tools:targetApi="29" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The whole of what background playback costs in configuration. `exported` is true because
             the things that connect to a media session live in other processes: the notification,
             Android Auto, Assistant, a wearable companion. The intent filter is how they find it. -->
        <service
            android:name=".DemoPlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
    </application>

</manifest>
