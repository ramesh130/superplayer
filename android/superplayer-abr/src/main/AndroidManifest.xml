<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      The same install-time permission core's manifest declares, for the same reason: this module's
      BandwidthOracle registers with the connectivity service to observe the transport a sample is
      keyed on. Declared here as well as in core so that lint checks this module's own call against
      this module's own manifest; a consumer's merged manifest carries it once either way, and
      Media3's exoplayer artifact already declares it. Core's manifest carries the argument for why
      this is not the case ADR-0007 rule 4 is about.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

</manifest>
