# --- Waiting on a device that leaves the listing ---------------------------------------------------
#
# wait_for_boot against a scripted `adb devices`: each poll reads the next listing in `$@`, and the
# last one repeats. `adb` itself answers `sys.boot_completed` as 1, so a serial listed as `device` is
# booted. Restarting and booting are recorded rather than done; the fake boot lists emulator-5558.
# Run in a subshell, since `die` exits and the fakes must not outlive the case.
waits() { # replaceable listing...
    local replaceable="$1" i=0 listing
    shift
    rm -rf "$scratch/wait" && mkdir -p "$scratch/wait"
    for listing in "$@"; do
        i=$((i + 1))
        printf 'List of devices attached\n%b' "$listing" > "$scratch/wait/listing-$i"
    done
    printf '#!/bin/sh\necho 1\n' > "$scratch/wait/adb" && chmod +x "$scratch/wait/adb"
    (
        ADB="$scratch/wait/adb" BOOT_POLL_INTERVAL=0.1 VANISHED_GRACE=1 EMULATOR_PID="" SERIAL=emulator-5556
        adb_devices() {
            local n
            n="$(cat "$scratch/wait/polls" 2>/dev/null || echo 0)"
            n=$((n + 1))
            printf '%s' "$n" > "$scratch/wait/polls"
            if [ -f "$scratch/wait/booted" ]; then
                printf 'List of devices attached\nemulator-5558\tdevice\n'
            elif [ "$n" -le "$i" ]; then
                cat "$scratch/wait/listing-$n"
            else
                cat "$scratch/wait/listing-$i"
            fi
        }
        emulator_pids() { [ -z "${ZOMBIE:-}" ] || echo 4242; }
        kill_emulator() { echo "kill_emulator $*" >> "$scratch/wait/calls"; }
        boot_avd() {
            echo boot_avd >> "$scratch/wait/calls"
            touch "$scratch/wait/booted"
            EMULATOR_PID=$$ SERIAL=emulator-5558
        }
        device_property() { echo superplayer_verify_36; }
        SERIAL="${WAIT_SERIAL:-$SERIAL}"
        wait_for_boot "$SERIAL" 20 "$replaceable" && echo "ready: $SERIAL"
    ) 2>&1
    cat "$scratch/wait/calls" 2>/dev/null || true
}

