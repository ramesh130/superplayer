<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      The install-time permission core already declares, declared again because this module's own code
      reads the network: DownloadConditions.kt watches whether the network in use is metered under Data
      Saver (ADR-0013 rule 10). Lint checks a module against its own manifest and not against the ones it
      merges with, so core's declaration does not satisfy it here. A consumer gains nothing it did not
      already have: core, Media3's exoplayer artifact and WorkManager all declare the same permission.
      The service and the foreground-service and notification permissions a download needs outside a
      screen are the app's, and are not declared here (ADR-0013 rule 3).
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

</manifest>
