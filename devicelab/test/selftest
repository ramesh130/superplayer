printf 'uncommitted\n' >> "$plant_repo/src/App.kt"
if dirty="$(in_plant_lab bash -c '. "$1/lib/common.sh"; . "$1/lib/plants.sh"; DEVICELAB_HOME="$2"; plant_apply slow "$3"' \
    plant "$lab" "$plant_lab" "$plant_repo")"; then
    fail "a plant is refused on a dirty tree"
else
    assert_contains "a plant is refused on a dirty tree, and says why" "$dirty" "clean tree"
fi
git -C "$plant_repo" checkout -q -- .

if rotten="$(in_plant_lab bash -c '. "$1/lib/common.sh"; . "$1/lib/plants.sh"; DEVICELAB_HOME="$2"; plant_apply rotten "$3"' \
    plant "$lab" "$plant_lab" "$plant_repo")"; then
    fail "a patch that does not apply fails the check"
else
    assert_contains "a patch that does not apply is named" "$rotten" "plant 'rotten' does not apply"
fi
assert_eq "and the tree is left as it was" "" "$(git -C "$plant_repo" status --porcelain)"

if unknown="$(in_plant_lab bash -c '. "$1/lib/common.sh"; . "$1/lib/plants.sh"; DEVICELAB_HOME="$2"; plant_file absent' \
    plant "$lab" "$plant_lab")"; then
    fail "an unknown plant fails"
else
    assert_contains "an unknown plant fails, naming the plants there are" "$unknown" "available: rotten slow"
fi

# Every shipped plant still applies to this repository's HEAD: a patch against demo sources rots as the
# demo changes, and this is where that is found, rather than after a boot. Checked against the index
# (`--cached`), so a contributor's uncommitted edits cannot fail it.
for plant in $(plants_available); do
    if checked="$(git -C "$REPO_ROOT" apply --check --cached "$(plant_file "$plant")" 2>&1)"; then pass; else
        fail "plant '$plant' applies to this repository's HEAD" "$checked"
    fi
done

# ---------------------------------------------------------------------------------------------------

status=0
assert_summary devicelab || status=1

# Each consumer's device-free half, run as its own process so that it sources only what it needs.
for consumer in "$lab"/*/test/selftest; do
    [ -x "$consumer" ] || continue
    "$consumer" || status=1
done
exit "$status"
