# --- Plants ----------------------------------------------------------------------------------------
#
# Against a scratch repository with a plants directory of its own, so that applying and reverting is
# exercised for real — `git apply` on a tree — without touching this one. Each case runs in a subshell,
# since `die` exits. The scratch repository is its own Gradle build, so the cases against it set
# GRADLE_DIR empty over the `android` common.sh names; the nested case below is this repository's shape.

plant_lab="$scratch/plant-lab"
plant_repo="$scratch/plant-repo"
mkdir -p "$plant_lab/plants" "$plant_repo/src"
printf 'fun onCreate() {\n}\n' > "$plant_repo/src/App.kt"
git -C "$plant_repo" init -q
git -C "$plant_repo" add .
git -C "$plant_repo" -c user.name=selftest -c user.email=selftest@invalid commit -q -m base
plant_base="$(git -C "$plant_repo" rev-parse HEAD)"

# The planted change, recorded the way a real plant is made: edit, `git diff`, check out again. It
# modifies a tracked file and adds an untracked one, because a real plant (an Application subclass)
# does both, and a revert has to remove what it added.
printf 'fun onCreate() {\n    readEverything()\n}\n' > "$plant_repo/src/App.kt"
printf 'fun readEverything() {}\n' > "$plant_repo/src/Read.kt"
git -C "$plant_repo" add -N src/Read.kt
git -C "$plant_repo" diff > "$plant_lab/plants/slow.patch"
git -C "$plant_repo" reset -q
git -C "$plant_repo" checkout -q -- .
rm "$plant_repo/src/Read.kt"
printf 'this is not a patch\n' > "$plant_lab/plants/rotten.patch"

in_plant_lab() { (DEVICELAB_HOME="$plant_lab" && "$@") 2>&1; }

assert_eq "plants are listed by name, from the plants directory" "rotten slow" \
